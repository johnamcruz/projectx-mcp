{
  "name": "projectx-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets a reasoning model (Claude, ChatGPT) trade TopstepX / ProjectX futures accounts",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "projectx-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
