{
	"info": {
		"_postman_id": "15382f81-7e4c-44c7-ba60-5e20b4b34937",
		"name": "ProjectX",
		"description": "ProjectX Gateway API (TopstepX). Set username and apiKey, run Authenticate once; the token is stored in {{token}} and used by every other request. Docs: https://gateway.docs.projectx.com/docs/intro",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "593968"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://api.topstepx.com"
		},
		{
			"key": "username",
			"value": ""
		},
		{
			"key": "apiKey",
			"value": ""
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "accountId",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Authenticate",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "text/plain",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userName\": \"{{username}}\",\n    \"apiKey\": \"{{apiKey}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/Auth/loginKey",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"Auth",
						"loginKey"
					]
				},
				"auth": {
					"type": "noauth"
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Save the session token for every other request in this collection.",
							"const body = pm.response.json();",
							"if (body.success && body.token) pm.collectionVariables.set(\"token\", body.token);"
						]
					}
				}
			]
		},
		{
			"name": "Validate",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "text/plain",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/Auth/validate",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"Auth",
						"validate"
					]
				}
			},
			"response": []
		},
		{
