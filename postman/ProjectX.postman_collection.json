						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"accountId\": {{accountId}}, // Replace with your actual account ID\n  \"contractId\": \"CON.F.US.ENQ.U25\", // Replace with the contract ID you want to trade\n  \"type\": 2, // Market order\n  \"side\": 0, // 0 - Bid (buy), 1 = Ask (sell)\n  \"size\": 1 // Size of the order\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/Order/place",
					"host": [
						"{{baseUrl}}"
					],
