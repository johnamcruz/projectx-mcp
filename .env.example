# ── Credentials (required) ─────────────────────────────────────────────
# Your TopstepX platform login username (NOT your email, NOT an account name).
PROJECTX_USERNAME=
# API key from https://topstepx.com/settings?tab=api
PROJECTX_API_KEY=

# ── Endpoints (defaults are TopstepX; change for another ProjectX firm) ─
# PROJECTX_API_URL=https://api.topstepx.com
# PROJECTX_MARKET_HUB_URL=https://rtc.topstepx.com/hubs/market

# ── Trading guardrails ─────────────────────────────────────────────────
# Order-writing tools are refused unless this is true.
PROJECTX_TRADING_ENABLED=false
# Comma-separated account IDs the model may trade. Empty = any tradable account.
PROJECTX_ALLOWED_ACCOUNT_IDS=
# Comma-separated symbol roots the model may trade, e.g. MNQ,MES. Empty = any.
PROJECTX_ALLOWED_SYMBOLS=
# Max contracts per order, and max absolute net position per contract.
PROJECTX_MAX_ORDER_SIZE=1
PROJECTX_MAX_POSITION_SIZE=2
# Stop opening new risk once realized P&L (net of fees) for the current
# trading day (starts 17:00 America/Chicago) is at or below -this value. 0 = off.
PROJECTX_MAX_DAILY_LOSS=500

# ── Protection check (runs only with trading enabled) ─────────────────
# Every N seconds (minimum 5), close any position of this server's own trades
# (account+contract pairs it sent an order on today, per the journal) that
# working stops on the opposite side don't cover for its whole size. 0 = off.
# PROJECTX_RECONCILE_SECONDS=30
# A position is closed only after it was seen uncovered on two checks at least
# this far apart, and no order was sent on that contract within this window.
# PROJECTX_RECONCILE_GRACE_SECONDS=15

# ── Learning journal ───────────────────────────────────────────────────
# JSONL file where the model's rationales, reviews, and lessons are stored.
# PROJECTX_JOURNAL_PATH=~/.projectx-mcp/journal.jsonl

# ── HTTP transport (for ChatGPT / remote clients) ──────────────────────
# PORT=8787
# HOST=127.0.0.1
# Required for HTTP mode (16+ chars, e.g. `openssl rand -hex 32`).
# Clients send `Authorization: Bearer <token>` to /mcp, or use the URL /mcp/<token>.
# MCP_HTTP_AUTH_TOKEN=

# ── ngrok tunnel (optional, HTTP mode only) ────────────────────────────
# With an authtoken set, the server opens an ngrok tunnel on startup and logs
# the public https URL. Token: https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=
# Reserved domain for a stable URL (e.g. my-name.ngrok.app). Blank = random URL.
# NGROK_DOMAIN=
